# Copy this file to .env and fill in your own values.
PORT=5000

# Local PostgreSQL: replace YOUR_PASSWORD with the password you chose during install.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/finance_dashboard

# Set to true for cloud databases (Neon, Supabase, Render, ...)
DATABASE_SSL=false

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app runs (for CORS)
CLIENT_URL=http://localhost:5173
